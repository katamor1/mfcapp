#pragma code_page(65001)

#include "Resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#ifndef APSTUDIO_INVOKED
#include "targetver.h"
#endif
#include "afxres.h"
#include "verrsrc.h"
#undef APSTUDIO_READONLY_SYMBOLS

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_JPN)
LANGUAGE 17, 1

IDR_MAINFRAME ICON "res\\mfcapp.ico"

IDR_MAINFRAME MENU
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "終了(&X)", ID_APP_EXIT
    END
    POPUP "ヘルプ(&H)"
    BEGIN
        MENUITEM "棚管理GUIについて(&A)...", ID_APP_ABOUT
    END
END

IDD_ABOUTBOX DIALOGEX 0, 0, 190, 70
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "棚管理GUI について"
FONT 9, "Yu Gothic UI"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,14,14,21,20
    LTEXT           "棚管理GUI  MVP",IDC_STATIC,44,14,132,10,SS_NOPREFIX
    LTEXT           "Copyright (C) 2026",IDC_STATIC,44,29,132,9
    DEFPUSHBUTTON   "OK",IDOK,126,49,54,14,WS_GROUP
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,1
 PRODUCTVERSION 1,0,0,1
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104B0"
        BEGIN
            VALUE "CompanyName", "ShelfManager"
            VALUE "FileDescription", "棚管理GUI"
            VALUE "FileVersion", "1.0.0.1"
            VALUE "InternalName", "mfcapp.exe"
            VALUE "LegalCopyright", "Copyright (C) 2026"
            VALUE "OriginalFilename", "mfcapp.exe"
            VALUE "ProductName", "棚管理GUI"
            VALUE "ProductVersion", "1.0.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0411, 1200
    END
END

STRINGTABLE
BEGIN
    IDR_MAINFRAME       "棚管理GUI"
    AFX_IDS_APP_TITLE   "棚管理GUI"
    AFX_IDS_IDLEMESSAGE "準備完了"
    ID_APP_ABOUT        "製品情報とバージョンを表示します。\n製品情報"
    ID_APP_EXIT         "棚管理GUIを終了します。\n終了"
END

#endif

#ifndef APSTUDIO_INVOKED
#define _AFX_NO_OLE_RESOURCES
#define _AFX_NO_TRACKER_RESOURCES
#define _AFX_NO_PROPERTY_RESOURCES

